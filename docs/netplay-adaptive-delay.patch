+namespace MelonDSAndroid
+{
+// Called once per frame by the receiving side with "did this frame's remote input arrive late". Decides how far ahead
+// the other device should publish its input: up when input is often late, and a cautious probe downwards when it never is.
+void MirrorSession::netAdaptDelay(bool late)
+{
+    netWinFrames++;
+    if (late) netWinLate++;
+    if (netWinFrames < kDelayWindow)
+        return;
+
+    uint32_t lateCount = netWinLate;
+    netWinFrames = netWinLate = 0;
+    if (netSettleWindows > 0)
+    {
+        netSettleWindows--; // the window right after a change still holds frames from the old delay
+        return;
+    }
+    int wanted = netPeerDelay;
+
+    if (netProbing)
+    {
+        if (lateCount >= 4)
+        {
+            // The lower delay does not work on this network: go back and wait longer before the next try
+            wanted = netPeerDelay + 1;
+            netProbeBackoff = std::min<uint32_t>(netProbeBackoff * 2, kProbeBackoffBase * 16);
+            netNextProbeFrame = netFrame + netProbeBackoff;
+            netProbing = false;
+            netCalmWindows = 0;
+            LOGI("netplay: input delay %d failed (%u of %u frames late), going back", netPeerDelay, lateCount, kDelayWindow);
+        }
+        else if (++netCalmWindows >= 4)
+        {
+            netProbing = false;
+            netProbeBackoff = kProbeBackoffBase;
+            netNextProbeFrame = netFrame + netProbeBackoff;
+            LOGI("netplay: input delay %d works", netPeerDelay);
+        }
+    }
+    else if (lateCount >= 6)
+    {
+        wanted = netPeerDelay + 1;
+        netNextProbeFrame = netFrame + netProbeBackoff;
+        netCalmWindows = 0;
+    }
+    else
+    {
+        netCalmWindows = lateCount <= 1 ? netCalmWindows + 1 : 0;
+        if (netPeerDelay > kMinDelay && netFrame >= netNextProbeFrame && netCalmWindows >= 10)
+        {
+            wanted = netPeerDelay - 1;
+            netProbing = true;
+            netCalmWindows = 0;
+        }
+    }
+
+    wanted = std::max(kMinDelay, std::min(kMaxDelay, wanted));
+    if (wanted != netPeerDelay)
+    {
+        LOGI("netplay: asking the other device for input delay %d (was %d, %u of %u frames late)", wanted, netPeerDelay,
+             lateCount, kDelayWindow);
+        netPeerDelay = wanted;
+        netSettleWindows = 1;
+        std::vector<uint8_t> msg;
+        msg.push_back(MsgDelay);
+        put(msg, (uint8_t) wanted);
+        net->send(msg.data(), msg.size(), true);
+        net->flush();
+    }
+}
